@@ -0,0 +1,96 @@
+﻿namespace = stdinnv_gp
+
+# =============================================================================
+# SteadyInnovMod — dynamic Great Power prestige controller (2026-07-08, rev B)
+# Design: hk-config/roadmap/ROADMAP-gp-og-gate.md (user-reviewed D1-D5)
+# -----------------------------------------------------------------------------
+# THE FORMULA (00_country_ranks.txt): GP bar = 5.0 x AVERAGE country prestige
+# (or 0.75 x top country). A hoarding player inflates the average and organic GPs
+# fall out. The bar is engine-computed, so we never calculate it — this is a
+# FEEDBACK controller on the nation's ACTUAL rank.
+#
+# Every 30 days, per opted-in nation (stdinnv_gp_active, set by the decision):
+#   1. If no longer a CANDIDATE (stdinnv_gp_candidate, single trigger file):
+#      FULL DEACTIVATE — strip the modifier, clear all vars, END the event chain.
+#      The decision re-arms automatically (its is_shown checks the flag), so a
+#      nation that re-qualifies later simply takes it again (boost restarts at 0).
+#   2. Else, if below GP rank AND the GP roster is deficient (< 9 GPs): ramp the
+#      integral boost and re-apply the unit modifier at the new magnitude.
+#      THE CAP IS LOAD-BEARING: every pumped point raises the 5x-average bar for
+#      everyone (~5% of the pumped amount); ~20 uncapped concurrent pumps would
+#      raise the bar as fast as the ramp (treadmill, no convergence) and knock
+#      organic GPs below it. Capping at 9 makes the system a thermostat: pumps
+#      engage only while the roster is short, then hold and the bar stabilises.
+#   3. GP count uses the verified counter-loop (set_variable + every_country +
+#      ROOT writeback, desi-vetted); `any_country = { count >= N }` exists only
+#      COMMENTED in vanilla and was rejected as unverified.
+# War does NOT pause the controller (a GP bleeding prestige in a war is exactly
+# when the pump matters); war only gates TAKING the decision.
+#
+# Tokens verified vs game files 2026-07-08: else = { } (scripted_effects/events);
+# scripted trigger in event limit (`x = yes`, ai_triggers); every_country + limit
+# (00_chris_scripted_effects); country_rank >= rank_value:great_power; guarded
+# remove_modifier / remove_variable (repo effect-guard rule); add_modifier
+# { multiplier = var:X } permanent-modifier rescale (montenegrin raiding).
+# TODO tune in game: RAMP_STEP (300), cadence (30d), roster target (9).
+# =============================================================================
+stdinnv_gp.1 = {
+	type = country_event
+	hidden = yes
+
+	# Runs only while the nation is opted in (set by the decision when_taken).
+	trigger = {
+		has_variable = stdinnv_gp_active
+	}
+
+	immediate = {
+		# guard-init the integral boost, once (set-before-change).
+		if = {
+			limit = { NOT = { has_variable = stdinnv_gp_boost } }
+			set_variable = { name = stdinnv_gp_boost value = 0 }
+		}
+
+		if = {
+			# (1) candidacy lost -> FULL DEACTIVATE + end chain (no reschedule).
+			limit = { NOT = { stdinnv_gp_candidate = yes } }
+			if = {
+				limit = { has_modifier = stdinnv_great_power_prestige }
+				remove_modifier = stdinnv_great_power_prestige
+			}
+			remove_variable = stdinnv_gp_boost
+			if = {
+				limit = { has_variable = stdinnv_gp_count }
+				remove_variable = stdinnv_gp_count
+			}
+			remove_variable = stdinnv_gp_active   # re-arms the decision
+		}
+		else = {
+			# (3) count the current great powers (overwrite each cycle).
+			set_variable = { name = stdinnv_gp_count value = 0 }
+			every_country = {
+				limit = { country_rank >= rank_value:great_power }
+				ROOT = { change_variable = { name = stdinnv_gp_count add = 1 } }
+			}
+
+			# (2) ramp only while below GP AND the roster is short of 9.
+			if = {
+				limit = {
+					NOT = { country_rank >= rank_value:great_power }
+					var:stdinnv_gp_count < 9   # roster target, tune
+				}
+				change_variable = { name = stdinnv_gp_boost add = 300 } # RAMP_STEP, tune
+				if = {
+					limit = { has_modifier = stdinnv_great_power_prestige }
+					remove_modifier = stdinnv_great_power_prestige
+				}
+				add_modifier = {
+					name = stdinnv_great_power_prestige
+					multiplier = var:stdinnv_gp_boost
+				}
+			}
+
+			# reschedule the controller (chain continues only while active).
+			trigger_event = { id = stdinnv_gp.1 days = 30 }
+		}
+	}
+}
