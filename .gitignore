# --- hkvault: only ENCRYPTED notes are committed -------------------------
# Plaintext markdown is treated as secret. Git physically cannot commit it;
# only the encrypted <name>.md.age (produced by `git seal`) is tracked.
*.md
# (*.md.age ends in .age, so it is NOT matched by *.md above — it stays tracked)
# allowlist: these *.md are deliberately kept plaintext + tracked (no PII).
# Must stay in sync with EXCLUDE_FILES in bin/hkvault.py.
!README.md
!CHECKPOINTS.md
# HOWTO.md must be READABLE BEFORE the vault is unsealed - it is the doc that tells you
# how to unseal it. Same chicken-and-egg exemption as RECOVERY.txt. Keep it PII-free.
!HOWTO.md

# local seal cache (plaintext hashes; never share)
.vaultcache.json

# never commit an age private key, anywhere
identity.key
*.key

# machine-specific reference paths (commit only refpaths.example.json)
config/refpaths.json

# machine-specific git identity baseline for the health check
# (commit only gitidentity.example.json — the real one names the cross-project
#  XplanMagic identity, which must never land in this PUBLIC repo)
config/gitidentity.json

# private TODO tracker — user-designated PII; NEVER commit (build script tracked, output isn't)
data/TODO.csv
data/TODO.xlsx
*.xlsx

# screenshots / images are private (may show local paths); seal them with
# tools/githk_seal_todo.ps1 -Path <file> and commit only the .age
*.jpg
*.jpeg
*.png

# --- Python / OS / editor cruft ------------------------------------------
__pycache__/
*.pyc
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/
*.iml
out/
